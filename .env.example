# Copy to `.env.local` for local simulation or `.env.qa.local` for QA.
# Never commit real secrets.

APP_ENV=local
APP_MODE=IDP
NODE_ENV=development

# Firebase / Identity Platform
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID

# reCAPTCHA Enterprise
# RECAPTCHA_SITE_KEY is public and is exposed to the browser as recaptchaSiteKey.
# RECAPTCHA_API_KEY is private, backend-only, and must be restricted to reCAPTCHA Enterprise API.
VITE_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_ENTERPRISE_SITE_KEY
RECAPTCHA_PROJECT_ID=etb-identity-omnicanal
RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_ENTERPRISE_SITE_KEY
RECAPTCHA_API_KEY=YOUR_RECAPTCHA_ENTERPRISE_ASSESSMENT_API_KEY

# OIDC/CORS local origins
VITE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional canonical IdP origin for QA/Cloud Run while there is no corporate domain.
# Use one single run.app origin here and in Firebase action links.
VITE_IDP_URL=
CANONICAL_IDP_ORIGIN=
# true in preview/production if direct IdP access must be blocked.
REQUIRE_OIDC_REDIRECT=false
# CSP hardening. Start with Report-Only, review Cloud Run logs, then tune.
CSP_REPORT_ONLY=false
# Optional override. Leave empty to use the server default report-only policy.
CONTENT_SECURITY_POLICY_REPORT_ONLY=
CSP_REPORT_URI=/api/security/csp-report

# MuleSoft endpoints and credentials.
# Leave empty in `.env.local` to keep simulation mode.
# Fill with QA values in `.env.qa.local`.
# If an OAuth body field is intentionally blank in QA, keep the key with an
# empty value; the BFF preserves explicit blanks instead of falling back.
MULESOFT_OAUTH_URL=
MULESOFT_BASE_URL_MS1=
MULESOFT_BASE_URL_MS2=
MULESOFT_BASE_URL_MS3=
MULESOFT_CLIENT_ID=
MULESOFT_CLIENT_SECRET=
MULESOFT_OAUTH_CLIENT_ID=
MULESOFT_OAUTH_CLIENT_SECRET=
MULESOFT_OAUTH_ACCOUNT_ID=
MULESOFT_ENABLE_MS4=false
LOOKUP_RATE_LIMIT_MAX=10
OTP_SEND_RATE_LIMIT_MAX=5
OTP_VALIDATE_RATE_LIMIT_MAX=15
ID_QUERY_MAX_PER_HOUR=5

# Local Firebase Admin for BFF registration tests
GOOGLE_APPLICATION_CREDENTIALS=

# E2E helpers
TEST_USER_EMAIL="testuser@dummymail.com"
TEST_USER_PASSWORD="#123456789"
LIVE_OTP_CODE=
LIVE_TEST_PASSWORD=
