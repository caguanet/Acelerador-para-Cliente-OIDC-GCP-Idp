{
  "name": "oidc-identity-provider",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=18",
    "pnpm": ">=11"
  },
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.mjs",
    "dev": "vite",
    "dev:qa": "vite --mode qa --force",
    "dev:full": "node scripts/cleanup-ports.mjs && concurrently -n bff,spa -c blue,green \"node scripts/run-env.mjs .env.local pnpm --dir server start\" \"pnpm run dev\"",
    "dev:full:qa": "node scripts/cleanup-ports.mjs && node scripts/dev-full-qa.mjs",
    "dev:simulation": "node scripts/cleanup-ports.mjs && concurrently -n bff,idp,mock -c blue,green,magenta \"node scripts/run-optional-env.mjs .env.local pnpm --dir server start\" \"vite --force\" \"vite -c vite.config.mock.js --force\"",
    "dev:qa:simulation": "node scripts/cleanup-ports.mjs && concurrently \"pnpm run dev:qa\" \"vite -c vite.config.mock.js --mode qa --force\"",
    "server:qa": "node scripts/run-env.mjs .env.qa.local pnpm --dir server start",
    "build": "tsc && vite build",
    "prepare": "node scripts/install-hooks.mjs",
    "test": "vitest",
    "test:bff": "vitest run server/server.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "verify:skills": "node scripts/verify-skills-lock.mjs",
    "verify:public-config": "node scripts/assert-public-config-safe.mjs",
    "skills:refresh-lock": "node scripts/update-skills-lock-hashes.mjs",
    "verify:regression": "node scripts/verify-regression.mjs",
    "verify:ci": "pnpm run verify:regression"
  },
  "dependencies": {
    "firebase": "^10.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/dotenv": "^6.1.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@types/node": "^20.0.0",
    "concurrently": "^9.2.1",
    "jsdom": "^24.0.0",
    "typescript": "^5.0.2",
    "vite": "^4.3.0",
    "vitest": "^1.3.1",
    "dotenv": "^16.3.1"
  }
}
